<?xml version="1.0" encoding="utf-8"?>
<!--
  Rulebox MSI, the agent service (plan Phase 6, Section 4.10).

  Names and arguments must equal the agent's own `service install`
  (apps\agent\src\service.rs: SERVICE_NAME, DISPLAY_NAME, service_info) and
  AGENT_SERVICE in crates\rulebox-win32\src\service.rs. apps\installer\tests\package.test.ts
  compares them.

  No Account: the service runs as LocalSystem. The MSI leaves Windows' default service DACL
  (only SYSTEM and Administrators can stop or change it; interactive users can query it) and
  no required-privileges list. The agent sets its own DACL and privilege list while a lockdown
  policy is applied (apps\agent\src\lockdown\tamper.rs, L7) and puts the originals back when it
  is removed. Step 22 run A saw the defaults on an installed, not enrolled PC, as expected.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Fragment>
    <ComponentGroup Id="ServiceGroup" Directory="INSTALLFOLDER">

      <Component Id="RuleboxAgentComponent">
        <File Id="RuleboxAgentExe" Name="rulebox-agent.exe" Source="$(BinDir)\rulebox-agent.exe" KeyPath="yes" />

        <ServiceInstall
            Id="RuleboxAgentService"
            Name="RuleboxAgent"
            DisplayName="Rulebox Agent"
            Description="Enforces Rulebox kiosk settings on this PC."
            Type="ownProcess"
            Start="auto"
            ErrorControl="normal"
            Vital="yes"
            Arguments="service run">
          <!--
            Restart on the first, second and third failure after 5 s; the failure count resets
            after 1 day. Nested under ServiceInstall so it is applied with the install.
            (The agent's own `service install` uses 1 s, 5 s, 30 s; the MSI uses one delay.)
          -->
          <util:ServiceConfig
              FirstFailureActionType="restart"
              SecondFailureActionType="restart"
              ThirdFailureActionType="restart"
              RestartServiceDelayInSeconds="5"
              ResetPeriodInDays="1" />
        </ServiceInstall>

        <!-- Start at install, stop at install and uninstall (upgrade too), delete at uninstall. -->
        <ServiceControl
            Id="RuleboxAgentControl"
            Name="RuleboxAgent"
            Start="install"
            Stop="both"
            Remove="uninstall"
            Wait="yes" />
      </Component>

      <!--
        "Rulebox Setup" in the all-users Start menu: `rulebox-agent.exe setup` (plan 4.10.1).
        The UI.wxs finish page opens this same shortcut. A shortcut cannot be a key path, so the
        component is keyed by a registry value (HKLM, because the package is per machine).
      -->
      <Component Id="SetupShortcutComponent" Directory="RuleboxMenuFolder" Bitness="always64">
        <Shortcut
            Id="SetupShortcut"
            Name="Rulebox Setup"
            Description="Check this PC and connect it to your Rulebox dashboard"
            Target="[#RuleboxAgentExe]"
            Arguments="setup"
            WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveRuleboxMenuFolder" On="uninstall" />
        <RegistryValue Root="HKLM" Key="SOFTWARE\Rulebox\StartMenu" Name="Setup" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
    Uninstall only (Phase 6 Step 22 run A2, Q-A2, owner-approved 2026-11-26): a PC that is uninstalled leaves the dashboard,
    drops its device credentials and takes the RuleboxStaff account with it. The agent's unenroll command with its
    remove-staff-account option (apps\agent\src\enroll.rs) tells the backend, switches the kiosk off if it is still on, signs
    the Staff session out and deletes the account and its profile, and wipes the saved device secrets (secrets.bin) and
    the organization's data. Logs and the rest of ProgramData\Rulebox stay (the owner kept "logs stay").

    - It talks to the RUNNING service over the admin pipe (SYSTEM is allowed), so it runs Before="StopServices" and
      before RemoveFiles: the service and the exe are both still there. It is an EXE custom action run from the
      installed file, not a script. The "no EXE custom action" rule of Step 7 was lifted for this one action by the owner.
    - REMOVE="ALL" is a real uninstall. UPGRADINGPRODUCTCODE is set while a MAJOR UPGRADE removes the old product
      (MajorUpgrade is scheduled afterInstallInitialize, so the old product's removal runs in every upgrade): the action must
      never run then, or an upgrade would unenroll the PC. The same condition guards the kiosk check in Checks.wxs.
    - Return="ignore": the PC may be not enrolled, offline or the service stopped; the uninstall still goes on, and the
      Staff account stays then (the `unenroll` command can be run by hand).
    - The kiosk guard (Checks.wxs) has already refused the uninstall while the kiosk is on, so by now the PC is back to
      normal Windows.
    -->
    <CustomAction
        Id="UnenrollAtUninstall"
        FileRef="RuleboxAgentExe"
        ExeCommand="unenroll --remove-staff-account"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="UnenrollAtUninstall" Before="StopServices" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
