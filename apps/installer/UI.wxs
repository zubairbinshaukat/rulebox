<?xml version="1.0" encoding="utf-8"?>
<!--
  Rulebox MSI, the install dialogs (plan Phase 6, Section 4.10).

  WixUI_Minimal: one page with the licence text and the Install button, a progress page,
  and a finish page. The finish page has a checkbox, on by default, that opens the
  "Rulebox Setup" Start menu shortcut (Service.wxs). A silent install (/qn) shows no
  dialogs, so it never launches Setup; it enrolls through ENROLLCODE instead.

  This is the only custom action in the package. It is a DLL entry point from the WiX Util
  extension (ShellExecute on a shortcut): no script and no EXE. It runs as the user, so the
  agent's `setup` manifest must ask for administrator (a UAC prompt, plan Step 8).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Fragment>
    <WixVariable Id="WixUILicenseRtf" Value="$(InstallerDir)\License.rtf" />
    <!-- Logo bitmaps made by `pnpm gen:brand` (top banner; left panel of the welcome and finish pages). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(RepoRoot)\assets\brand\installer\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(RepoRoot)\assets\brand\installer\dialog.bmp" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start Rulebox Setup now to check this PC and connect it to your dashboard" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- ShellExecute on the shortcut: the shortcut carries the "setup" argument. -->
    <Property Id="WixShellExecTarget" Value="[RuleboxMenuFolder]Rulebox Setup.lnk" />

    <CustomAction Id="LaunchRuleboxSetup" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_X64" Impersonate="yes" Return="check" />

    <UI Id="RuleboxUI">
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchRuleboxSetup" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Fragment>
</Wix>
