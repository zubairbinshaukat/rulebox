/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.convex.cloud; font-src 'self'; connect-src 'self' https://*.convex.cloud wss://*.convex.cloud https://*.convex.site; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# index.html and the other unhashed files keep the Pages default
# ("public, max-age=0, must-revalidate"): a new deploy is seen on the next load.
# Content-hashed build files (scripts, styles, fonts, the boot script) never
# change under the same name: cache them for a year without revalidating.
# (Not set on /* as well: Pages joins two values of one header with a comma.)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The deployment's backend address, read at start: never cached.
/config.json
  Cache-Control: no-store

# The forgot-PIN page (its link carries a secret in the URL fragment; the page strips it,
# and nothing of the address may travel in a Referer). Pages joins the values of one header
# from every matching rule with a comma ("strict-origin-when-cross-origin, no-referrer"), and
# a browser takes the LAST valid policy of such a list: no-referrer. (This file has no way to
# leave a path out of "/*". vercel.json does it with a negative match instead.)
/pin-reset
  Referrer-Policy: no-referrer
