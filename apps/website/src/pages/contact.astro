---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { SUPPORT_EMAIL, TURNSTILE_SITE_KEY } from "../config";
import { organizationLd } from "../lib/seo";
---

<Base title="Contact Rulebox" description="Email support@rulebox.org with questions about Rulebox, early access, press or partnerships. Security reports have their own process." path="/contact" og="contact" forms ld={[organizationLd()]} crumbs={[{ name: "Contact", path: "/contact" }]}>
  <PageHero label="Contact" title="Talk to us." sub="Email us, or use the form. A short message is fine. We reply by email." primary={{ label: SUPPORT_EMAIL, href: `mailto:${SUPPORT_EMAIL}` }} tone="blue" compact />

  <section class="section-tight">
    <div class="container layout">
      <form class="form card" method="post" action="/api/contact" data-form="contact" data-sitekey={TURNSTILE_SITE_KEY} data-support={SUPPORT_EMAIL} novalidate>
        <div class="row2">
          <div class="field">
            <label for="c-name">Your name</label>
            <input class="input" id="c-name" name="name" autocomplete="name" required maxlength="120" />
          </div>
          <div class="field">
            <label for="c-email">Email</label>
            <input class="input" id="c-email" name="email" type="email" autocomplete="email" required maxlength="200" />
          </div>
        </div>
        <div class="field">
          <label for="c-topic">Topic</label>
          <div class="select-wrap" data-select>
          <select class="select" id="c-topic" name="topic" required>
            <option value="general">General question</option>
            <option value="press">Press</option>
            <option value="partnership">Partnership</option>
            <option value="security">Security (not a vulnerability report)</option>
          </select>
          <Icon name="alt-down" class="select-chev" />
          </div>
        </div>
        <div class="field">
          <label for="c-msg">Message</label>
          <textarea class="textarea" id="c-msg" name="message" required maxlength="5000"></textarea>
        </div>
        <div class="hp" aria-hidden="true"><label>Leave empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <button class="btn btn-primary btn-lg" type="submit">Send message<Icon name="arrow-right" /></button>
        <p class="form-msg" role="status" aria-live="polite" hidden></p>
        <noscript><p class="muted">This form needs JavaScript for its spam check. Email us instead: <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a>.</p></noscript>
      </form>

      <aside class="side">
        <div class="card" data-tone="mint">
          <span class="tile-icon"><Icon name="letter" /></span>
          <h2 class="h3">Email us</h2>
          <p class="mail"><a class="text-link" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></p>
        </div>
        <div class="card" data-tone="coral">
          <span class="tile-icon"><Icon name="shield" /></span>
          <h2 class="h3">Found a security problem?</h2>
          <p class="muted">Please do not use this form. Follow the <a class="text-link" href="/security/disclosure">disclosure process</a> or email <a class="text-link" href={`mailto:${SUPPORT_EMAIL}?subject=Security%20report`}>{SUPPORT_EMAIL}</a> with “Security” in the subject.</p>
        </div>
        <div class="card" data-tone="sun">
          <span class="tile-icon"><Icon name="users" /></span>
          <h2 class="h3">Want Rulebox on your PCs?</h2>
          <p class="muted">Leave your email on the <a class="text-link" href="/early-access">early-access page</a>.</p>
        </div>
      </aside>
    </div>
  </section>
</Base>

<script>
  import "../scripts/forms.ts";
</script>

<style>
  .layout {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: var(--sp-10);
    }
  }
  .form {
    display: grid;
    gap: var(--sp-6);
  }
  .row2 {
    display: grid;
    gap: var(--sp-6) var(--sp-5);
  }
  @media (min-width: 640px) {
    .row2 {
      grid-template-columns: 1fr 1fr;
    }
  }
  .form .btn {
    justify-self: start;
  }
  .side {
    display: grid;
    gap: var(--sp-3);
  }
  .side .card {
    display: grid;
    grid-template-columns: var(--icon-col) 1fr;
    column-gap: var(--sp-4);
    row-gap: var(--sp-1);
    align-items: center;
    padding: var(--sp-5) var(--sp-6);
  }
  .side .tile-icon {
    grid-row: span 2;
    align-self: start;
    width: var(--icon-col);
    height: var(--icon-col);
    border-radius: 12px;
    font-size: 22px;
  }
  .side .h3 {
    font-family: var(--font-sans);
    font-size: var(--fs-h4);
    font-weight: var(--fw-strong);
    letter-spacing: 0;
    line-height: var(--lh-tight);
  }
  .side p {
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .side .mail {
    font-size: var(--fs-h4);
    font-weight: var(--fw-strong);
    overflow-wrap: anywhere;
  }
</style>