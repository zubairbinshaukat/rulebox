---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { articleLd } from "../../lib/seo";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/blog/${entry.id}`;
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  type="article"
  og="blog"
  noindex={entry.data.draft}
  crumbs={[{ name: "Blog", path: "/blog" }, { name: entry.data.title, path }]}
  ld={[articleLd({ type: "BlogPosting", title: entry.data.title, description: entry.data.description, path, date: entry.data.date.toISOString(), author: entry.data.author })]}
>
  <article class="container post">
    <p class="mono muted">{entry.data.date.toISOString().slice(0, 10)} · {entry.data.author}</p>
    <h1 class="h1">{entry.data.title}</h1>
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .post {
    display: grid;
    gap: 22px;
    padding-top: 24px;
    padding-bottom: 96px;
  }
</style>
