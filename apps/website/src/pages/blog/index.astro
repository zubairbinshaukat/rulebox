---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import { isoDate, longDate, readMinutes } from "../../lib/content";

const posts = (await getCollection("blog", (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
---

<Base
  title="Blog | Rulebox"
  description="Guides to locking down shared Windows PCs, notes from building Rulebox, and why we chose what we chose. Written by the people who build it."
  path="/blog"
  crumbs={[{ name: "Blog", path: "/blog" }]}
>
  <PageHero label="Blog" title="Guides and notes from the build." sub="Plain guides to locking down shared Windows PCs, and how Rulebox is made." tone="coral" compact />
  <section class="section-tight">
    <div class="container">
      {
        posts.length === 0 ? (
          <p class="lead">
            The first posts are being written. Subscribe through the{" "}
            <a class="text-link" href="/blog/rss.xml">
              RSS feed
            </a>{" "}
            to get them.
          </p>
        ) : (
          <ul class="posts" role="list">
            {posts.map((p) => (
              <li>
                <article class="post">
                  <img src={`/og/blog-${p.id}.png`} width="1200" height="630" alt="" decoding="async" />
                  <div class="post-text">
                    <p class="meta">
                      <time datetime={isoDate(p.data.date)}>{longDate(p.data.date)}</time>
                      <span aria-hidden="true">·</span>
                      <span>{readMinutes(p.body)} min read</span>
                    </p>
                    <h2 class="h3 post-title">
                      <a href={`/blog/${p.id}`}>{p.data.title}</a>
                    </h2>
                    <p class="muted excerpt">{p.data.description}</p>
                    <span class="read" aria-hidden="true">
                      Read the guide <Icon name="arrow-right" />
                    </span>
                  </div>
                </article>
              </li>
            ))}
          </ul>
        )
      }
      <p class="rss">
        <Icon name="bell" />
        <span>New posts by <a class="text-link" href="/blog/rss.xml">RSS</a>.</span>
      </p>
    </div>
  </section>
</Base>

<style>
  .posts {
    display: grid;
    gap: var(--grid-gap);
  }
  @media (min-width: 760px) {
    .posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .post {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transition:
      transform 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }
  .post:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .post img {
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--line);
  }
  .post-text {
    display: grid;
    align-content: start;
    gap: var(--sp-3);
    padding: var(--card-pad);
  }
  .meta {
    display: flex;
    gap: var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .post-title a {
    text-decoration: none;
  }
  /* The whole card is the link target. */
  .post-title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .post:hover .post-title a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .excerpt {
    font-size: var(--fs-small);
  }
  .read {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--sp-2);
    font-size: var(--fs-small);
    font-weight: var(--fw-strong);
    color: var(--primary-text);
  }
  .rss {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-8);
    font-size: var(--fs-small);
    color: var(--muted);
  }
</style>
