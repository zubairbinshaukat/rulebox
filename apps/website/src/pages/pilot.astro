---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { CONTACT_EMAIL, TURNSTILE_SITE_KEY } from "../config";
import { USE_CASES } from "../data/useCases";
const uses = [...USE_CASES.filter((u) => !u.hub).map((u) => u.name), "Warehouse or factory floor", "NGO or community centre", "Library or public PCs", "Government counter", "Something else"];
---

<Base
  title="Join the Rulebox Pilot"
  description="Rulebox is invite-only during the pilot. Tell us about your PCs and we will reply by email."
  path="/pilot"
  og="pilot"
  forms
  crumbs={[{ name: "Pilot", path: "/pilot" }]}
>
  <PageHero label="Pilot" title="Join the pilot." sub="Rulebox is invite-only during the pilot. Tell us about your PCs and we will reply by email. Pilot organisations pay nothing." tone="sun" compact />

  <section class="section-tight">
    <div class="container layout">
      <form class="form card" method="post" action="/api/pilot" data-form="pilot" data-sitekey={TURNSTILE_SITE_KEY} novalidate>
        <div class="row2">
          <div class="field">
            <label for="p-name">Your name</label>
            <input class="input" id="p-name" name="name" autocomplete="name" required maxlength="120" />
          </div>
          <div class="field">
            <label for="p-email">Work email</label>
            <input class="input" id="p-email" name="email" type="email" autocomplete="email" required maxlength="200" />
          </div>
        </div>
        <div class="field">
          <label for="p-org">Organisation</label>
          <input class="input" id="p-org" name="organisation" autocomplete="organization" required maxlength="160" />
        </div>
        <div class="row2">
          <div class="field">
            <label for="p-pcs">Number of PCs</label>
            <div class="select-wrap" data-select>
            <select class="select" id="p-pcs" name="pcs" required>
              <option value="">Choose</option>
              <option>1-5</option>
              <option>6-20</option>
              <option>21-100</option>
              <option>101-500</option>
              <option>More than 500</option>
            </select>
            <Icon name="alt-down" class="select-chev" />
            </div>
          </div>
          <div class="field">
            <label for="p-use">What the PCs are used for</label>
            <div class="select-wrap" data-select>
            <select class="select" id="p-use" name="useCase" required>
              <option value="">Choose</option>
              {uses.map((u) => <option>{u}</option>)}
            </select>
            <Icon name="alt-down" class="select-chev" />
            </div>
          </div>
        </div>
        <div class="field">
          <label for="p-win">Windows editions, if you know <span class="opt">(optional)</span></label>
          <input class="input" id="p-win" name="windows" maxlength="160" placeholder="For example: Windows 11 Pro, some Windows 10 Home" />
        </div>
        <div class="field">
          <label for="p-msg">Anything else <span class="opt">(optional)</span></label>
          <textarea class="textarea" id="p-msg" name="message" maxlength="3000"></textarea>
        </div>
        <label class="check consent">
          <input class="checkbox" type="checkbox" name="consent" value="yes" required />
          <span>You may email me about my pilot request. We use these details only to reply, as described in the <a class="text-link" href="/legal/privacy">privacy notice</a>.</span>
        </label>
        <div class="hp" aria-hidden="true"><label>Leave empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <button class="btn btn-primary btn-lg" type="submit">Send pilot request<Icon name="arrow-right" /></button>
        <p class="form-msg" role="status" aria-live="polite" hidden></p>
        <noscript><p class="muted">This form needs JavaScript for its spam check. Email us instead: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p></noscript>
      </form>

      <aside class="next">
        <h2 class="h3">What happens next</h2>
        <ol role="list">
          <li data-tone="blue"><span class="n mono">1</span><span>We read every request and reply by email.</span></li>
          <li data-tone="sun"><span class="n mono">2</span><span>If it is a fit, you get an invite to your own dashboard.</span></li>
          <li data-tone="mint"><span class="n mono">3</span><span>Install on one test PC first. Rulebox changes how the PC starts.</span></li>
        </ol>
        <p class="muted">Prefer email? <a class="text-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
        <p class="muted">Want to look first? <a class="text-link" href="/docs">Read the docs</a> or <a class="text-link" href="/open-source">the source</a>.</p>
      </aside>
    </div>
  </section>
</Base>

<script>
  import "../scripts/forms.ts";
</script>

<style>
  .layout {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: var(--sp-10);
    }
    .next {
      position: sticky;
      top: 112px;
    }
  }
  .form {
    display: grid;
    gap: var(--sp-6);
  }
  .row2 {
    display: grid;
    gap: var(--sp-6) var(--sp-5);
  }
  @media (min-width: 640px) {
    .row2 {
      grid-template-columns: 1fr 1fr;
    }
  }
  .opt {
    font-weight: var(--fw-body);
    color: var(--muted);
  }
  .consent {
    padding-top: var(--sp-1);
  }
  .form .btn {
    justify-self: start;
  }
  .next {
    display: grid;
    gap: var(--sp-5);
    padding-top: var(--sp-2);
  }
  .next ol {
    display: grid;
    grid-auto-rows: 1fr;
    gap: var(--sp-2);
    margin-bottom: var(--sp-2);
  }
  .next li {
    display: grid;
    grid-template-columns: var(--icon-col) 1fr;
    gap: var(--sp-4);
    align-items: center;
    min-height: var(--row-h);
    padding: var(--sp-4);
    border-radius: var(--radius);
    background: var(--tone-soft);
    color: var(--ink-2);
    line-height: var(--lh-tight);
  }
  .n {
    display: grid;
    place-items: center;
    width: var(--icon-col);
    height: var(--icon-col);
    border-radius: 12px;
    background: var(--tone);
    color: var(--tone-on, var(--ink));
    font-weight: var(--fw-strong);
  }
</style>