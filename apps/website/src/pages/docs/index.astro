---
import Docs from "../../layouts/Docs.astro";
import Icon from "../../components/Icon.astro";
import { docGroups } from "../../lib/content";
import { ISSUES_URL } from "../../config";

const groups = await docGroups();
const quick = [
  { n: 1, title: "What is Rulebox", href: "/docs/start-here/what-is-rulebox", text: "The three parts and what they do." },
  { n: 2, title: "Download and verify", href: "/docs/install/download-and-verify", text: "Get the installer and check its hash." },
  { n: 3, title: "Enrol a PC", href: "/docs/install/enrol-a-pc", text: "Type a code; the PC becomes a workstation." },
];
---

<Docs
  title="Rulebox documentation"
  description="Set up Rulebox, enrol PCs, understand the security design, host it yourself and contribute to the project."
  path="/docs"
  home
>
  <section class="quick" aria-labelledby="quick-title">
    <h2 id="quick-title" class="q-title">Quick start</h2>
    <ol class="q-list" role="list">
      {
        quick.map((q) => (
          <li>
            <a class="q-card" href={q.href}>
              <span class="q-n">{q.n}</span>
              <span class="q-text">
                <strong>{q.title}</strong>
                <span>{q.text}</span>
              </span>
              <Icon name="arrow-right" class="q-go" />
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="sections-title">
    <h2 id="sections-title" class="q-title">Browse by section</h2>
    <ul class="cards" role="list">
      {
        groups.map((g) => (
          <li class="card-s" data-tone={g.tone}>
            <a class="cs-head" href={`/docs/${g.pages[0]!.id}`}>
              <span class="tile-icon">
                <Icon name={g.icon} />
              </span>
              <span class="cs-name">{g.name}</span>
            </a>
            <p class="cs-text">{g.text}</p>
            <ul class="cs-pages" role="list">
              {g.pages.map((p) => (
                <li>
                  <a href={`/docs/${p.id}`}>
                    <span>{p.data.title}</span>
                    {p.data.draft && <span class="tag-draft">Draft</span>}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <aside class="help">
    <Icon name="question" />
    <p>
      Something missing or wrong? <a href={ISSUES_URL}>Open an issue on GitHub</a>, or read the{" "}
      <a href="/blog">blog</a> for longer guides.
    </p>
  </aside>
</Docs>

<style>
  section + section {
    margin-top: var(--sp-9);
  }
  .q-title {
    margin-bottom: var(--sp-4);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    font-weight: var(--fw-strong);
    color: var(--ink);
  }
  .q-list {
    display: grid;
    gap: var(--sp-3);
  }
  @media (min-width: 720px) {
    .q-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .q-card {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    height: 100%;
    padding: var(--sp-4);
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .q-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-sm);
  }
  .q-n {
    flex: none;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--primary-soft);
    color: var(--primary-text);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: var(--fw-strong);
  }
  .q-text {
    display: grid;
    gap: 2px;
    flex: 1;
    font-size: var(--fs-small);
    line-height: var(--lh-tight);
  }
  .q-text span {
    color: var(--muted);
    font-size: var(--fs-xs);
  }
  .q-card :global(.q-go) {
    color: var(--faint);
    margin-top: 4px;
    transition: transform 0.2s var(--ease);
  }
  .q-card:hover :global(.q-go) {
    color: var(--primary-text);
    transform: translateX(2px);
  }
  .cards {
    display: grid;
    gap: var(--sp-4);
  }
  @media (min-width: 720px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .card-s {
    display: grid;
    align-content: start;
    gap: var(--sp-3);
    padding: var(--sp-5);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .cs-head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
  }
  .cs-head .tile-icon {
    width: 40px;
    height: 40px;
    font-size: 20px;
    border-radius: 12px;
  }
  .cs-name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.15;
    color: var(--ink);
  }
  .cs-head:hover .cs-name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .cs-text {
    color: var(--muted);
    font-size: var(--fs-small);
  }
  .cs-pages {
    display: grid;
    padding-top: var(--sp-2);
    border-top: 1px solid var(--line);
  }
  .cs-pages a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    min-height: 36px;
    font-size: var(--fs-small);
    color: var(--ink-2);
    text-decoration: none;
  }
  .cs-pages a:hover {
    color: var(--primary-text);
  }
  .tag-draft {
    flex: none;
    padding: 1px 6px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: var(--fw-medium);
  }
  .help {
    display: flex;
    gap: var(--sp-3);
    align-items: flex-start;
    margin-top: var(--sp-9);
    padding: var(--sp-4) var(--sp-5);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--ink-2);
    font-size: var(--fs-small);
  }
  .help :global(.icon) {
    flex: none;
    margin-top: 2px;
    color: var(--muted);
  }
  .help a {
    color: var(--accent-text);
  }
</style>
