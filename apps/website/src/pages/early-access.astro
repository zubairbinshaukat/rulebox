---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SignupForm from "../components/SignupForm.astro";
import { SUPPORT_EMAIL } from "../config";
---

<Base
  title="Join Rulebox Early Access"
  description="Rulebox is invite-only during early access. Leave your email to try it now, or to hear when it opens to everyone."
  path="/early-access"
  og="early-access"
  forms
  crumbs={[{ name: "Early access", path: "/early-access" }]}
>
  <PageHero label="Early access" title="Join early access." sub="Rulebox is invite-only during early access. Leave your email, and tick the box if you want to try it now. Early-access organisations pay nothing." tone="sun" compact />

  <section class="section-tight">
    <div class="container layout">
      <div class="form card">
        <SignupForm id="signup" label="Your email" />
      </div>

      <aside class="next">
        <h2 class="h3">What happens next</h2>
        <ol role="list">
          <li data-tone="blue"><span class="n mono">1</span><span>We email you once to confirm your address.</span></li>
          <li data-tone="sun"><span class="n mono">2</span><span>If you ticked “I want to try it now”, we reply by email. If it is a fit, you get an invite to your own dashboard.</span></li>
          <li data-tone="mint"><span class="n mono">3</span><span>Install on one test PC first. Rulebox changes how the PC starts.</span></li>
        </ol>
        <p class="muted">Questions? <a class="text-link" href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></p>
        <p class="muted">Want to look first? <a class="text-link" href="/docs">Read the docs</a> or <a class="text-link" href="/open-source">the source</a>.</p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .layout {
    display: grid;
    gap: var(--sp-7);
    align-items: start;
  }
  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: var(--sp-10);
    }
    .next {
      position: sticky;
      top: 112px;
    }
  }
  .form {
    display: grid;
  }
  .form :global(.signup) {
    max-width: none;
  }
  .next {
    display: grid;
    gap: var(--sp-5);
    padding-top: var(--sp-2);
  }
  .next ol {
    display: grid;
    grid-auto-rows: 1fr;
    gap: var(--sp-2);
    margin-bottom: var(--sp-2);
  }
  .next li {
    display: grid;
    grid-template-columns: var(--icon-col) 1fr;
    gap: var(--sp-4);
    align-items: center;
    min-height: var(--row-h);
    padding: var(--sp-4);
    border-radius: var(--radius);
    background: var(--tone-soft);
    color: var(--ink-2);
    line-height: var(--lh-tight);
  }
  .n {
    display: grid;
    place-items: center;
    width: var(--icon-col);
    height: var(--icon-col);
    border-radius: 12px;
    background: var(--tone);
    color: var(--tone-on, var(--ink));
    font-weight: var(--fw-strong);
  }
</style>
