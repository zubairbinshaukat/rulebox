---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import sansUrl from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import serifUrl from "@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url";
import { IS_PRODUCTION, SITE_NAME } from "../config";
import { breadcrumbLd, canonical, fullTitle, ogImageUrl, type PageMeta } from "../lib/seo";

interface Props extends PageMeta {
  /** JSON-LD objects for this page. */
  ld?: object[];
  crumbs?: { name: string; path: string }[];
  /** Page needs the form script and Turnstile. */
  forms?: boolean;
  /** Remove the default bottom spacing before the footer. */
  flush?: boolean;
}

const { title, description, path, type = "website", noindex = false, ld = [], crumbs, forms = false } = Astro.props;
/* One social card per page, generated by scripts/og.mjs into public/og/. */
const og = path === "/" ? "home" : path.slice(1).replaceAll("/", "-");
const pageTitle = fullTitle(title);
const url = canonical(path);
const image = ogImageUrl(og);
const robots = noindex || !IS_PRODUCTION ? "noindex, nofollow" : "index, follow";

const allLd = crumbs?.length ? [...ld, breadcrumbLd([{ name: "Home", path: "/" }, ...crumbs])] : ld;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta name="robots" content={robots} />
    {noindex && <meta name="rb-noindex" content="true" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {/* Light-only site: same as --lt-bg (node scripts/contrast.mjs --hex prints it). */}
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f9f7f3" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Rulebox blog" href="/blog/rss.xml" />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    {/* Marks that JavaScript runs, before first paint. Hashed in the CSP by headers.mjs. */}
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    {allLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    {/* Turnstile is the one third-party script, loaded by forms.ts only when a visitor starts a form. */}
    {forms && <link rel="preconnect" href="https://challenges.cloudflare.com" />}
  </head>
  <body>
    {/* The home page puts its logo preloader here (Preloader.astro): first thing in <body>. */}
    <slot name="preload" />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main">
      {crumbs?.length ? <Breadcrumbs items={crumbs} /> : null}
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
