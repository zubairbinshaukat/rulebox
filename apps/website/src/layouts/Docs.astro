---
/*
 * Docs layout (own content collection, not Starlight). Three columns on wide
 * screens: grouped sidebar, the article, "On this page" with scroll-spy.
 * Phones get a collapsible docs menu. Same header, footer, fonts, tokens and
 * Solar icons as the marketing pages; one small script (scripts/prose.ts)
 * for copy buttons, heading anchors, table wrappers and scroll-spy.
 *
 * MDX in docs can use <Callout> and <Steps> without importing them
 * (passed in by pages/docs/[...slug].astro).
 */
import Base from "./Base.astro";
import Icon from "../components/Icon.astro";
import { REPO_URL } from "../config";
import { articleLd } from "../lib/seo";
import { docGroups, isoDate, longDate, readMinutes } from "../lib/content";

interface Props {
  title: string;
  description: string;
  path: string;
  section?: string;
  updated?: Date;
  draft?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
  editPath?: string;
  /** Raw MDX body, for the reading time. */
  body?: string;
  /** The docs home: no reading meta, no table of contents, no prev/next. */
  home?: boolean;
}
const { title, description, path, section, updated, draft = false, headings = [], editPath, body, home = false } = Astro.props;

const groups = await docGroups();
const flat = groups.flatMap((g) => g.pages);
const idx = flat.findIndex((p) => `/docs/${p.id}` === path);
const prev = idx > 0 ? flat[idx - 1] : undefined;
const next = idx >= 0 && idx < flat.length - 1 ? flat[idx + 1] : undefined;
const group = groups.find((g) => g.name === section);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const crumbs = [{ name: "Docs", path: "/docs" }, ...(home ? [] : [{ name: title, path }])];
const minutes = readMinutes(body);
const current = flat[idx];
---

<Base
  title={`${title} | Rulebox Docs`}
  description={description}
  path={path}
  og="docs"
  noindex={draft}
  crumbs={crumbs}
  crumbsInline
  ld={[articleLd({ type: "TechArticle", title, description, path, modified: updated ? isoDate(updated) : undefined })]}
>
  <div class:list={["container docs", { "docs-home": home }]}>
    <nav class="side" aria-label="Docs">
      <details open class="side-box" data-docs-nav>
        <summary>
          <span class="sum-icon"><Icon name="list-linear" /></span>
          <span class="sum-text">
            <span class="sum-label">Docs menu</span>
            <span class="sum-page">{current ? current.data.title : "Overview"}</span>
          </span>
          <span class="sum-chev"><Icon name="alt-down" /></span>
        </summary>
        <a class="side-home" href="/docs" aria-current={home ? "page" : undefined}>
          <Icon name="book" />
          <span>Overview</span>
        </a>
        {
          groups.map((g) => (
            <div class="grp" data-tone={g.tone}>
              <p class="grp-name">
                <span class="grp-icon">
                  <Icon name={g.icon} />
                </span>
                {g.name}
              </p>
              <ul role="list">
                {g.pages.map((p) => {
                  const href = `/docs/${p.id}`;
                  return (
                    <li>
                      <a href={href} aria-current={href === path ? "page" : undefined}>
                        <span>{p.data.title}</span>
                        {p.data.draft && <span class="tag-draft">Draft</span>}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </details>
      {/* Phones: the menu starts closed. Runs before paint, so nothing jumps. */}
      <script is:inline>
        (function () {
          var d = document.currentScript.previousElementSibling;
          if (d && matchMedia("(max-width: 899px)").matches) d.removeAttribute("open");
        })();
      </script>
    </nav>

    <article class="main">
      <header class="doc-head">
        <nav class="doc-crumbs" aria-label="Breadcrumb">
          <ol role="list">
            <li><a href="/">Home</a></li>
            {
              home ? (
                <li>
                  <span aria-current="page">Docs</span>
                </li>
              ) : (
                <>
                  <li>
                    <a href="/docs">Docs</a>
                  </li>
                  <li>
                    <span aria-current="page">{title}</span>
                  </li>
                </>
              )
            }
          </ol>
        </nav>
        {
          group && (
            <p class="eyebrow" data-tone={group.tone}>
              <Icon name={group.icon} />
              {group.name}
            </p>
          )
        }
        <h1 class="doc-title">{title}</h1>
        <p class="doc-lede">{description}</p>
        {
          !home && (
            <p class="doc-meta">
              <span>
                <Icon name="clock-linear" />
                {minutes} min read
              </span>
              {updated && (
                <span>
                  <Icon name="calendar-linear" />
                  Last updated <time datetime={isoDate(updated)}>{longDate(updated)}</time>
                </span>
              )}
              {editPath && (
                <a href={`${REPO_URL}/edit/main/apps/website/${editPath}`}>
                  <Icon name="pen-linear" />
                  Edit on GitHub
                </a>
              )}
            </p>
          )
        }
      </header>
      {
        draft && (
          <aside class="callout" data-kind="warning">
            <p class="callout-head">
              <Icon name="danger" />
              Draft
            </p>
            <p class="callout-body">This page is being written and checked against the release. Details may change.</p>
          </aside>
        )
      }
      <div class:list={["doc-body", { "prose flush": !home }]}>
        <slot />
      </div>

      {
        !home && (prev || next) && (
          <nav class="pager" aria-label="Previous and next page">
            {prev ? (
              <a class="pg prev" href={`/docs/${prev.id}`} rel="prev">
                <span class="pg-dir">
                  <Icon name="arrow-left" /> Previous
                </span>
                <span class="pg-title">{prev.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a class="pg next" href={`/docs/${next.id}`} rel="next">
                <span class="pg-dir">
                  Next <Icon name="arrow-right" />
                </span>
                <span class="pg-title">{next.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>

    {
      !home && (
        <aside class="toc" aria-label="On this page">
          {toc.length > 0 && (
            <div class="toc-box" data-toc>
              <p class="toc-name">On this page</p>
              <ul role="list">
                {toc.map((h) => (
                  <li data-depth={h.depth}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {editPath && (
            <a class="toc-edit" href={`${REPO_URL}/edit/main/apps/website/${editPath}`}>
              <Icon name="pen-linear" /> Suggest an edit
            </a>
          )}
        </aside>
      )
    }
  </div>
</Base>

<script>
  import "../scripts/prose.ts";
</script>

<style>
  /* ---------- Grid ---------- */
  .docs {
    display: grid;
    gap: var(--sp-6);
    padding-top: calc(var(--sp-12) + var(--sp-2));
    padding-bottom: var(--section-y);
  }
  @media (min-width: 900px) {
    .docs {
      grid-template-columns: 236px minmax(0, 1fr);
      column-gap: var(--sp-9);
    }
  }
  @media (min-width: 1240px) {
    .docs {
      grid-template-columns: 236px minmax(0, 1fr) 216px;
      column-gap: var(--sp-10);
    }
    .docs-home {
      grid-template-columns: 236px minmax(0, 1fr);
    }
  }

  /* ---------- Sidebar ---------- */
  .side-box > summary {
    display: none;
  }
  @media (min-width: 900px) {
    .side {
      position: sticky;
      top: 100px;
      align-self: start;
      max-height: calc(100vh - 120px);
      overflow-y: auto;
      padding-right: var(--sp-2);
      scrollbar-width: thin;
    }
  }
  @media (max-width: 899px) {
    .side-box {
      border-radius: var(--radius);
      background: var(--surface);
      border: 1px solid var(--line);
      box-shadow: var(--shadow-xs);
    }
    .side-box > summary {
      display: flex;
      align-items: center;
      gap: var(--sp-3);
      min-height: 56px;
      padding: var(--sp-2) var(--sp-4);
      cursor: pointer;
      list-style: none;
    }
    .side-box > summary::-webkit-details-marker {
      display: none;
    }
    .side-box[open] > summary {
      border-bottom: 1px solid var(--line);
    }
    .side-box[open] {
      padding-bottom: var(--sp-3);
    }
    .side-box > :not(summary) {
      margin-inline: var(--sp-3);
    }
    .side-box > .side-home {
      margin-top: var(--sp-3);
    }
  }
  .sum-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--sp-2);
    background: var(--surface-2);
    color: var(--ink-2);
  }
  .sum-text {
    display: grid;
    min-width: 0;
    flex: 1;
    line-height: var(--lh-tight);
  }
  .sum-label {
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .sum-page {
    font-weight: var(--fw-strong);
    font-size: var(--fs-small);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sum-chev {
    color: var(--muted);
    transition: transform 0.2s var(--ease);
  }
  .side-box[open] .sum-chev {
    transform: rotate(180deg);
  }
  .side-home {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 36px;
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--radius-sm);
    font-size: var(--fs-small);
    font-weight: var(--fw-medium);
    color: var(--ink-2);
    text-decoration: none;
  }
  .side-home :global(.icon) {
    color: var(--muted);
  }
  .side-home:hover {
    background: var(--surface-2);
    color: var(--ink);
  }
  .side-home[aria-current="page"] {
    background: var(--primary-soft);
    color: var(--primary-text);
  }
  .side-home[aria-current="page"] :global(.icon) {
    color: var(--primary-text);
  }
  .grp {
    margin-top: var(--sp-5);
  }
  .grp-name {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 32px;
    padding-inline: var(--sp-3) 0;
    font-size: var(--fs-small);
    font-weight: var(--fw-strong);
    color: var(--ink);
  }
  .grp-icon {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 7px;
    background: var(--tone-soft);
    color: var(--tone-ink);
  }
  .grp-icon :global(.icon) {
    width: 15px;
    height: 15px;
  }
  .grp ul {
    display: grid;
    margin: var(--sp-1) 0 0 calc(var(--sp-3) + 11px);
    border-left: 1px solid var(--line);
  }
  .grp a {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    min-height: 34px;
    padding: 6px var(--sp-3) 6px var(--sp-4);
    text-decoration: none;
    color: var(--muted);
    font-size: var(--fs-small);
    line-height: var(--lh-tight);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .grp a:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .grp a[aria-current="page"] {
    color: var(--primary-text);
    font-weight: var(--fw-strong);
    background: var(--primary-soft);
  }
  .grp a[aria-current="page"]::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    border-radius: 2px;
    background: var(--primary);
  }
  .tag-draft {
    flex: none;
    padding: 1px 6px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: var(--fw-medium);
    letter-spacing: 0.02em;
  }

  /* ---------- Article ---------- */
  .main {
    min-width: 0;
  }
  .doc-head {
    display: grid;
    gap: var(--sp-3);
    max-width: 72ch;
    padding-bottom: var(--sp-6);
    margin-bottom: var(--sp-7);
    border-bottom: 1px solid var(--line);
  }
  .doc-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .doc-crumbs li + li::before {
    content: "/";
    margin-right: var(--sp-2);
    color: var(--faint);
  }
  .doc-crumbs a {
    text-decoration: none;
  }
  .doc-crumbs a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .doc-crumbs [aria-current] {
    color: var(--ink-2);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
    font-size: var(--fs-small);
    font-weight: var(--fw-strong);
    color: var(--tone-ink);
  }
  .eyebrow :global(.icon) {
    width: 18px;
    height: 18px;
  }
  .doc-title {
    font-family: var(--font-display);
    font-weight: var(--fw-heading);
    font-size: clamp(2rem, 1.55rem + 1.3vw, 2.625rem);
    line-height: 1.1;
    letter-spacing: var(--ls-h2);
    color: var(--ink);
    text-wrap: balance;
  }
  .docs-home .doc-title {
    margin-top: var(--sp-3);
  }
  .doc-lede {
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--ink-2);
    max-width: 62ch;
  }
  .doc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    margin-top: var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .doc-meta > * {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .doc-meta a {
    color: var(--accent-text);
    text-decoration: none;
  }
  .doc-meta a:hover {
    text-decoration: underline;
  }
  .doc-meta :global(.icon) {
    width: 15px;
    height: 15px;
  }
  .main > .callout {
    max-width: 70ch;
    margin-bottom: var(--sp-7);
  }
  .doc-body {
    max-width: 70ch;
  }
  .docs-home .doc-body {
    max-width: 960px;
  }
  .doc-body :global(h2) {
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem);
    padding-top: var(--sp-2);
  }

  /* ---------- Prev / Next ---------- */
  .pager {
    display: grid;
    gap: var(--sp-3);
    max-width: 70ch;
    margin-top: var(--sp-10);
    padding-top: var(--sp-7);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }
  .pg {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-4) var(--sp-5);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.2s;
  }
  .pg:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow-sm);
  }
  .pg.next {
    text-align: right;
    justify-items: end;
    grid-column: -2;
  }
  .pg-dir {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .pg-title {
    font-weight: var(--fw-strong);
    color: var(--ink);
  }
  .pg:hover .pg-title {
    color: var(--primary-text);
  }

  /* ---------- On this page ---------- */
  .toc {
    display: none;
  }
  @media (min-width: 1240px) {
    .toc {
      display: grid;
      gap: var(--sp-6);
      align-content: start;
      position: sticky;
      top: 100px;
      align-self: start;
      max-height: calc(100vh - 120px);
      overflow-y: auto;
    }
  }
  .toc-name {
    margin-bottom: var(--sp-2);
    font-size: var(--fs-xs);
    font-weight: var(--fw-strong);
    color: var(--ink);
  }
  .toc ul {
    border-left: 1px solid var(--line);
  }
  .toc li {
    position: relative;
  }
  .toc a {
    display: block;
    padding: 5px var(--sp-3) 5px var(--sp-4);
    color: var(--muted);
    text-decoration: none;
    font-size: var(--fs-xs);
    line-height: var(--lh-tight);
    transition: color 0.15s;
  }
  .toc li[data-depth="3"] a {
    padding-left: calc(var(--sp-4) + var(--sp-3));
  }
  .toc a:hover {
    color: var(--ink);
  }
  .toc a[aria-current] {
    color: var(--primary-text);
    font-weight: var(--fw-strong);
  }
  .toc a[aria-current]::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 4px;
    bottom: 4px;
    width: 2px;
    border-radius: 2px;
    background: var(--primary);
  }
  .toc-edit {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--fs-xs);
    color: var(--muted);
    text-decoration: none;
  }
  .toc-edit:hover {
    color: var(--ink);
  }

  /* Docs tables: first column stays on one line on wide screens. */
  @media (min-width: 900px) {
    .main :global(.prose td:first-child) {
      white-space: nowrap;
    }
  }
</style>
