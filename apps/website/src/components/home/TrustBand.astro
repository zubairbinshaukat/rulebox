---
/*
 * Giant statement rising into the one dark band (Granola), then a short
 * "trusted by" note in Rulebox's own words. We have no customers to name
 * yet, so the band says so plainly: real names come only with permission.
 * The places Rulebox is built for are the photo cards in Places.astro, once;
 * this band no longer repeats them (owner, 2026-11-25: use cases appeared
 * three times on the home page).
 */
import Icon from "../Icon.astro";
const words = "The staff PC that only does its job.".split(" ");
---

<section class="statement" aria-label="What Rulebox is for">
  <p class="giant container" aria-label="The staff PC that only does its job.">
    {words.map((w, i) => <span class="w" style={`--i:${i}`} aria-hidden="true">{w} </span>)}
  </p>
</section>

<section class="band section-dark" aria-labelledby="trust-title">
  <div class="container">
    <div class="head">
      <h2 id="trust-title" class="h2">Built for teams that rely on a PC doing one job well.</h2>
      <p class="lead">One PC, many people, and nobody with time to fix it.</p>
    </div>

    <p class="honest">
      <Icon name="info" />
      <span>
        Rulebox is in invite-only early access. We will name the teams that use it here, once they agree in writing. Until then, you
        get the <a href="/security">design</a>, the <a href="/open-source">code</a> and <a href="/numbers">every number with its source</a>.
      </span>
    </p>
  </div>
</section>

<style>
  .statement {
    padding: clamp(40px, 8vw, 120px) 0 0;
    overflow: hidden;
  }
  .giant {
    font-size: clamp(3rem, 0.8rem + 8.4vw, 10rem);
    font-weight: 560;
    letter-spacing: -0.055em;
    line-height: 0.9;
    text-align: center;
    text-wrap: balance;
    padding-bottom: clamp(28px, 4vw, 56px);
  }
  .w {
    display: inline-block;
    white-space: pre;
  }
  /* The band slides up over the statement (home-motion.ts), so it paints
     above it with its own solid background. */
  .band {
    position: relative;
    z-index: 1;
    padding-block: clamp(72px, 9vw, 130px);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  }
  .head {
    display: grid;
    gap: 22px;
    max-width: 900px;
    margin: 0 auto clamp(40px, 5vw, 64px);
    text-align: center;
    justify-items: center;
  }
  .head .lead {
    color: var(--muted);
    max-width: 52ch;
  }
  .honest {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    max-width: 760px;
    margin: 40px auto 0;
    font-size: 0.98rem;
    color: var(--muted);
  }
  .honest :global(.icon) {
    margin-top: 3px;
    color: var(--c-sun);
  }
  .honest a {
    color: var(--ink);
  }
</style>
