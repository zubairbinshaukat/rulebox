---
/*
 * Home: where Rulebox fits, as six large photo cards (one per use-case page).
 * Desktop: a 4-column bento, wide card first and last, so two rows of three
 * cards come out even with no orphan. Tablet: 2 x 3. Phone: one row that
 * scrolls sideways with snap points and a peek of the next card.
 * Photos are the use-case page heroes (Pexels, credited on /legal/licenses).
 * Motion: CSS only, transform and opacity, none with reduced motion.
 */
import { Picture } from "astro:assets";
import Icon from "../Icon.astro";
import { USE_CASES } from "../../data/useCases";
import { USE_CASE_PHOTOS } from "../../data/photos";

/* Hub first (wide), hotels last (wide): both photos are landscape scenes. */
const order = [
  "shared-staff-pcs",
  "retail-pos",
  "schools-and-computer-labs",
  "clinics-and-pharmacies",
  "call-centres",
  "hotels-front-desk",
];
const cards = order
  .map((slug) => USE_CASES.find((u) => u.slug === slug))
  .filter((u): u is NonNullable<typeof u> => !!u)
  .map((u, i) => ({ u, photo: USE_CASE_PHOTOS[u.slug]!.hero, wide: i === 0 || i === order.length - 1 }));
---

<section class="places section" aria-labelledby="places-title">
  <div class="container">
    <div class="section-head split">
      <div class="head-main">
        <p class="label" style="--dot: var(--c-sun)">Use cases</p>
        <h2 id="places-title" class="h2 title">Made for the PCs that keep a place running.</h2>
      </div>
      <div class="head-side">
        <p class="lead">Tills, front desks, labs and shift floors. Pick yours to see how a day changes.</p>
        <a class="link-arrow" href="/use-cases">All use cases <Icon name="arrow-right" /></a>
      </div>
    </div>

    <ul class="cards" role="list">
      {
        cards.map(({ u, photo, wide }, i) => (
          <li class:list={["cell", { wide }]} style={`--i:${i}`}>
            <a class="uc" href={`/use-cases/${u.slug}`} data-tone={u.tone}>
              <Picture
                src={photo.src}
                alt=""
                formats={["avif"]}
                fallbackFormat="webp"
                widths={wide ? [480, 720, 960, 1280] : [360, 540, 720]}
                sizes={
                  wide
                    ? "(min-width: 1020px) 660px, (min-width: 720px) 46vw, 80vw"
                    : "(min-width: 1020px) 330px, (min-width: 720px) 46vw, 80vw"
                }
                quality={52}
                loading="lazy"
                decoding="async"
                class="img"
                style={photo.focus ? `object-position:${photo.focus}` : undefined}
              />
              <span class="scrim" aria-hidden="true" />
              <span class="tag">
                <Icon name={u.icon} />
                {u.place}
              </span>
              <div class="body">
                <h3 class="name">{u.name}</h3>
                <span class="line">{u.h1}</span>
                <span class="go" aria-hidden="true">
                  <Icon name="arrow-right" />
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .title {
    max-width: 16ch;
  }
  .head-side {
    display: grid;
    gap: var(--sp-4);
    justify-items: start;
    align-content: end;
  }
  .head-side .lead {
    max-width: 40ch;
  }

  /* ---------- Layout ---------- */
  .cards {
    --card-h: 400px;
    display: grid;
    gap: var(--grid-gap);
  }
  /* Phone: one sideways row that bleeds to the screen edges, snapping to
     the same gutter as the text above it. */
  @media (max-width: 719px) {
    .cards {
      grid-auto-flow: column;
      grid-auto-columns: min(82%, 340px);
      gap: var(--sp-3);
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      padding-bottom: var(--sp-2);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .cards::-webkit-scrollbar {
      display: none;
    }
    .cell {
      scroll-snap-align: start;
    }
    .uc {
      aspect-ratio: 4 / 5;
    }
  }
  @media (min-width: 720px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 340px;
    }
  }
  @media (min-width: 1020px) {
    .cards {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: var(--card-h);
    }
    .wide {
      grid-column: span 2;
    }
  }
  .cell {
    display: flex;
    min-width: 0;
  }

  /* ---------- Card ---------- */
  .uc {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-xl);
    background: var(--night);
    color: var(--on-night);
    text-decoration: none;
    box-shadow: var(--shadow-md);
  }
  .uc :global(picture) {
    display: contents;
  }
  .uc :global(.img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.001);
    transition: transform 0.9s var(--ease-out);
  }
  /* Soft scrim: clear at the top, deep at the bottom where the text sits. */
  .scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(
        to top,
        color-mix(in oklch, var(--night) 92%, transparent) 0%,
        color-mix(in oklch, var(--night) 72%, transparent) 28%,
        color-mix(in oklch, var(--night) 30%, transparent) 50%,
        transparent 68%
      ),
      var(--photo-dim);
  }
  /* Hairline inner edge so light photos keep a crisp border on paper. */
  .uc::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--hairline);
    pointer-events: none;
  }
  .tag {
    position: absolute;
    left: var(--sp-4);
    top: var(--sp-4);
    display: inline-flex;
    align-items: center;
    gap: 7px;
    max-width: calc(100% - var(--sp-4) * 2);
    padding: 6px 12px 6px 8px;
    border-radius: var(--radius-pill);
    background: var(--chip-glass);
    color: var(--chip-glass-ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    line-height: 1.2;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .tag :global(.icon) {
    width: 16px;
    height: 16px;
    color: var(--tone-ink);
  }
  /* Title across the full width; the one-line subtitle and the arrow share
     the last row, so narrow cards never squeeze the title. */
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--sp-2) var(--sp-4);
    padding: var(--sp-5);
  }
  .name {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-weight: var(--fw-heading);
    font-size: clamp(1.4rem, 1.2rem + 0.5vw, 1.75rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .wide .name {
    font-size: clamp(1.6rem, 1.1rem + 1.4vw, 2.5rem);
  }
  .line {
    font-size: var(--fs-small);
    line-height: 1.45;
    color: var(--on-night-muted);
    text-wrap: pretty;
    max-width: 36ch;
  }
  .go {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--chip-glass);
    color: var(--chip-glass-ink);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    transition: transform 0.45s var(--ease-out);
  }
  .go :global(.icon) {
    width: 20px;
    height: 20px;
    vertical-align: 0;
    transform: rotate(-45deg);
    transition: transform 0.45s var(--ease-out);
  }
  .uc:hover .go,
  .uc:focus-visible .go {
    transform: scale(1.06);
  }
  .uc:hover .go :global(.icon),
  .uc:focus-visible .go :global(.icon) {
    transform: rotate(0deg) translateX(2px);
  }
  .uc:hover :global(.img) {
    transform: scale(1.05);
  }
  .uc:focus-visible {
    outline-offset: 4px;
    border-radius: var(--radius-xl);
  }

  /* ---------- Reveal: cards rise in, a beat apart ---------- */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .cell {
        animation: rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry calc(40% + var(--i) * 4%);
      }
      /* The phone row scrolls sideways: a vertical view timeline would
         leave off-screen cards half revealed, so it rises as one block. */
      @media (max-width: 719px) {
        .cell {
          animation: none;
        }
        .cards {
          animation: rise linear both;
          animation-timeline: view();
          animation-range: entry 5% entry 50%;
        }
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .uc:hover :global(.img),
    .uc:hover .go,
    .uc:hover .go :global(.icon) {
      transform: none;
    }
    .go :global(.icon) {
      transform: none;
    }
  }
</style>
