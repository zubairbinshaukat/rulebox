import Login from "~icons/solar/login-2-bold-duotone";
import WidgetAdd from "~icons/solar/widget-add-bold-duotone";
import Info from "~icons/solar/info-circle-bold-duotone";
import Routing from "~icons/solar/routing-bold-duotone";
