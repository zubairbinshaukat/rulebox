import Window from "~icons/solar/window-frame-bold-duotone";
import KeyLinear from "~icons/solar/key-minimalistic-linear";
import RestartLinear from "~icons/solar/restart-linear";

const ICONS = {
  "arrow-right": ArrowRight,
  "arrow-up-right": ArrowUpRight,
  "alt-down": AltDown,
  lock: Lock,
  "lock-linear": LockLinear,
  shield: ShieldCheck,
  monitor: Monitor,
  "user-id": UserId,
  widget: Widget,
  laptop: Laptop,
  refresh: Refresh,
  offline: CloudCross,
  cpu: Cpu,
  folder: Folder,
  palette: Palette,
  wifi: Wifi,
  bell: Bell,
  undo: Undo,
  download: Download,
  code: Code,
  users: Users,
  sun: Sun,
  moon: Moon,
  menu: Menu,
  close: Close,
  check: Check,
  "check-linear": CheckLinear,
  danger: Danger,
  globe: Globe,
  calculator: Calculator,
  video: Video,
  shop: Shop,
  hospital: Hospital,
  school: School,
  headphones: Headphones,
  bed: Bed,
  box: Box,
  "hand-heart": HandHeart,
  library: Library,
  city: City,
  forbidden: Forbidden,
  key: Key,
  history: History,
  server: Server,
  layers: Layers,
  branch: Branch,
  copy: Copy,
  password: Password,
  settings: Settings,
  search: Magnifier,
  chat: Chat,
  question: Question,
  letter: Letter,
  checklist: Checklist,
  usb: Flash,
  power: Power,
  link: Link,
  "eye-closed": EyeClosed,
  leaf: Leaf,
  calendar: Calendar,
  clock: Clock,
  gallery: Gallery,
  music: Music,
  play: Play,
  file: File,
  "user-check": UserCheck,
  "user-block": UserBlock,
  logout: Logout,
  login: Login,
  "widget-add": WidgetAdd,
  info: Info,
  routing: Routing,
  database: Database,
  "cloud-download": CloudDownload,
  printer: Printer,
  book: Book,
  document: Document,
  programming: Programming,
  signpost: Signpost,
  cart: Cart,
  window: Window,
  "key-linear": KeyLinear,
  "restart-linear": RestartLinear,
} as const;

export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  class?: string;
  label?: string;
  size?: string;
}
const { name, class: className, label, size } = Astro.props;
const Cmp = ICONS[name];
if (!Cmp) throw new Error(`Icon "${name}" is not in the registry in Icon.astro`);
---

<Cmp
  class:list={["icon", className]}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  role={label ? "img" : undefined}
  style={size ? `width:${size};height:${size}` : undefined}
/>
