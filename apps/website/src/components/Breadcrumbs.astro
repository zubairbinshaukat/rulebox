---
interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
---

<nav class="crumbs container" aria-label="Breadcrumb">
  <ol role="list">
    <li><a href="/">Home</a></li>
    {
      items.map((it, i) => (
        <li>
          {i === items.length - 1 ? <span aria-current="page">{it.name}</span> : <a href={it.path}>{it.name}</a>}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs {
    padding-top: var(--sp-12);
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  li + li::before {
    content: "/";
    margin-right: var(--sp-2);
    color: var(--faint);
  }
  a {
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
  }
  [aria-current] {
    color: var(--ink-2);
  }
</style>
