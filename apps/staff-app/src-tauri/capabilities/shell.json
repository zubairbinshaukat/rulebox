{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "Shell windows (desktop, taskbar, popup, exit). No remote.",
  "windows": ["shell-*"],
  "permissions": [
    "core:event:default",
    "core:app:default",
    "allow-shell-state",
    "allow-ui-ready",
    "allow-ui-alive",
    "allow-dismiss-notice",
    "allow-dev-set-display",
    "allow-dev-set-boot",
    "allow-popup-open",
    "allow-popup-close",
    "allow-sign-in",
    "allow-sign-in-last",
    "allow-switch-user",
    "allow-launch-app",
    "allow-task-click",
    "allow-task-close",
    "allow-task-end",
    "allow-task-menu",
    "allow-show-desktop",
    "allow-refresh-catalogue"
  ]
}
