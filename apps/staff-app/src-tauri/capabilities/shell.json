{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shell",
  "description": "Shell windows (desktop, taskbar, popup). No remote. The exit dialog has its own capability.",
  "windows": ["shell-desktop", "shell-taskbar", "shell-popup"],
  "permissions": [
    "core:event:default",
    "core:app:default",
    "allow-shell-state",
    "allow-ui-ready",
    "allow-ui-alive",
    "allow-dev-note",
    "allow-dismiss-notice",
    "allow-notices-seen",
    "allow-set-volume",
    "allow-set-muted",
    "allow-set-brightness",
    "allow-set-theme",
    "allow-dev-set-display",
    "allow-dev-set-boot",
    "allow-popup-open",
    "allow-popup-close",
    "allow-sign-in",
    "allow-sign-in-last",
    "allow-switch-user",
    "allow-sign-out",
    "allow-closing-apps",
    "allow-lock",
    "allow-unlock",
    "allow-power-sleep",
    "allow-power-restart",
    "allow-power-shut-down",
    "allow-restart-rulebox",
    "allow-launch-app",
    "allow-task-click",
    "allow-task-close",
    "allow-task-end",
    "allow-task-menu",
    "allow-show-desktop",
    "allow-refresh-catalogue",
    "allow-open-doc",
    "allow-fs-list",
    "allow-fs-search",
    "allow-fs-recent",
    "allow-fs-files",
    "allow-fs-open",
    "allow-thumb-open",
    "allow-admin-exit-open",
    "allow-admin-exit-hotkey"
  ]
}
