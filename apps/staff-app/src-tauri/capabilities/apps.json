{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "apps",
  "description": "Built-in app windows. No remote. Nothing matches web-*.",
  "windows": ["app-*"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "allow-shell-state",
    "allow-dismiss-notice",
    "allow-open-doc",
    "allow-win-minimize",
    "allow-win-toggle-maximize",
    "allow-win-close",
    "allow-win-snap",
    "allow-app-snapshot",
    "allow-app-select-tab",
    "allow-app-close-tab",
    "allow-fs-list",
    "allow-fs-stat",
    "allow-fs-mkdir",
    "allow-fs-rename",
    "allow-fs-copy",
    "allow-fs-move",
    "allow-fs-trash",
    "allow-fs-trash-list",
    "allow-fs-restore",
    "allow-fs-purge",
    "allow-fs-usage",
    "allow-fs-search",
    "allow-fs-recent",
    "allow-fs-files",
    "allow-fs-clip-set",
    "allow-fs-clip-get",
    "allow-fs-paste",
    "allow-fs-handler",
    "allow-fs-open",
    "allow-fs-open-with",
    "allow-fs-read-text",
    "allow-fs-read-csv",
    "allow-fs-office-check",
    "allow-fs-image-info",
    "allow-admin-exit-open",
    "allow-admin-exit-hotkey"
  ]
}
